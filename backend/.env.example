# CareerCraft Backend BFF Environment Configuration (.env.example)

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=https://careercraft-platform.vercel.app
RATE_LIMIT_MAX=100

# Service-to-Service Security Token (min 32 characters)
INTERNAL_SERVICE_TOKEN=your_secure_internal_token_min_32_chars

# AI Gateway & Cloud Provider Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
LITELLM_URL=http://127.0.0.1:4001
LITELLM_MASTER_KEY=sk-careercraft-dev-key
OLLAMA_URL=http://127.0.0.1:11434
AI_MOCK_MODE=false
