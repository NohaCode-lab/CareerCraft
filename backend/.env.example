# Environment Variables Example for CareerCraft Backend BFF

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100

# AI Gateway & Provider Configuration
LITELLM_URL=http://127.0.0.1:4001
LITELLM_MASTER_KEY=sk-careercraft-dev-key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_URL=http://127.0.0.1:11434
AI_MOCK_MODE=false
