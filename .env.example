# CareerCraft Frontend Environment Configuration (.env.example)

# Application Metadata
VITE_APP_NAME=CareerCraft
VITE_DEFAULT_LANGUAGE=en

# Backend API Gateway Endpoint
VITE_API_BASE_URL=https://careercraft-backend.onrender.com/api/v1

# Optional Managed Supabase Cloud (Auth & Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key